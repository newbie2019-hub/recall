# The API. Everything else in this file is optional.
VITE_API_URL=http://localhost:8000/api/v1

# Phase 8 — the address a copyright notice or counter-notice is sent to,
# printed on /legal. Without it the page shows a placeholder, which is worse
# than nothing before a public launch.
VITE_ABUSE_CONTACT=abuse@example.invalid

# Phase 9 — live collaboration over Laravel Reverb. Leave the key empty and no
# websocket is opened at all: shared decks still load, edit and sync over HTTP,
# they simply do not update live. Match these to apps/api/.env.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
